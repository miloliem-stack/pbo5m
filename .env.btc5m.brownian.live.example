# BTC-5m Brownian conservative live one-shot profile.
# Copy to .env.btc5m.brownian.live.local and replace placeholders.
# Never commit .local files or real secrets.

BTC5M_STRATEGY_ID=brownian_no_hmm_conservative_v1
BTC5M_BROWNIAN_ENABLED=true
BTC5M_BROWNIAN_PAPER_ONLY=false
BTC5M_BROWNIAN_LIVE_ENABLED=true
BTC5M_EXECUTION_MODE=live
BTC5M_LIVE_ONE_SHOT=true
BTC5M_ALLOW_CONTINUOUS_LIVE=false
BTC5M_BROWNIAN_BANKROLL_USD=2000
BTC5M_BROWNIAN_MIN_MARKET_AGE_SECONDS=60
BTC5M_BROWNIAN_MAX_MARKET_AGE_SECONDS=240
BTC5M_BROWNIAN_EDGE_THRESHOLD=0.02
BTC5M_BROWNIAN_MIN_ASK=0.30
BTC5M_BROWNIAN_PROBABILITY_HAIRCUT_ABS=0.02
BTC5M_BROWNIAN_ASK_SLIPPAGE_ABS=0.01
BTC5M_BROWNIAN_KELLY_MULTIPLIER=0.025
BTC5M_BROWNIAN_MAX_STAKE_FRACTION=0.0025
BTC5M_BROWNIAN_SMALL_WALLET_THRESHOLD=2000
BTC5M_BROWNIAN_MIN_ORDER_NOTIONAL=5
BTC5M_BROWNIAN_TOP_N_LEVELS=10
BTC5M_BROWNIAN_MAX_DECISION_STALENESS_SECONDS=3.0

# Secrets/placeholders. Replace in .env.btc5m.brownian.live.local only.
# Live order submission requires py-clob-client-v2. Legacy py-clob-client V1 is refused.
# Normal live runs should use pre-created CLOB L2 credentials.
# Polymarket trading collateral is pUSD, not USDC.e. Use setup_polymarket_funder.py
# for manual wrapping/allowance diagnostics before live trading.
POLY_WALLET_PRIVATE_KEY=REPLACE_ME_DO_NOT_COMMIT
POLY_API_KEY=REPLACE_ME_DO_NOT_COMMIT
POLY_API_SECRET=REPLACE_ME_DO_NOT_COMMIT
POLY_API_PASSPHRASE=REPLACE_ME_DO_NOT_COMMIT
BTC5M_EXPECTED_WALLET_ADDRESS=REPLACE_ME_DO_NOT_COMMIT
USDC_E_TOKEN_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
PUSD_TOKEN_ADDRESS=0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB
POLY_COLLATERAL_ONRAMP_ADDRESS=0x93070a847efEf7F70739046A929D47a521F5B8ee
POLY_COLLATERAL_OFFRAMP_ADDRESS=REPLACE_IF_NEEDED
POLY_EXCHANGE_ADDRESS=REPLACE_ME_IF_DIRECT_ALLOWANCE_CHECK_REQUIRED
POLY_NEG_RISK_EXCHANGE_ADDRESS=REPLACE_ME_IF_NEEDED
POLY_RELAYER_URL=REPLACE_ME_IF_DEPOSIT_WALLET_MUTATION_SUPPORTED_LATER

# New deposit-wallet API flow commonly uses:
# POLY_SIGNATURE_TYPE=3
# POLY_FUNDER=<deposit wallet address>
#
# For legacy EOA/proxy/safe flows, use the matching signature type and funder:
# 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE, 3=POLY_1271.
